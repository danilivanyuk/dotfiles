[
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "ctrl-w t": "terminal_panel::ToggleFocus",
      "g ]": "editor::GoToDiagnostic",
      "g [": "editor::GoToPreviousDiagnostic",
      "g r": "editor::FindAllReferences",
      "shift-k": "editor::Hover",
      "space c a": "editor::ToggleCodeActions",
      "space g l": "activity_indicator::ShowErrorMessage",
      "space r n": "editor::Rename",
      "space l f": "editor::Format",
      "space l l": "diagnostics::Deploy",
      "g c c": "editor::ToggleComments",
      "space s f": "file_finder::Toggle",
      "space s g": "pane::DeploySearch",
      "space o": "tab_switcher::Toggle",
      "space p": "outline::Toggle",
      "space v": "editor::GoToDefinitionSplit",
      "space e e": "workspace::ToggleRightDock",
      "shift-l": "pane::ActivateNextItem",
      "shift-h": "pane::ActivatePreviousItem",
      "ctrl-x": "pane::CloseActiveItem",
      "ctrl-shift-x": "pane::CloseAllItems",
      "ctrl-shift-t": "pane::ReopenClosedItem",
      "space l g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {}
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w z": "workspace::ToggleZoom",
      "ctrl-w t": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-[": "editor::Outdent",
      "ctrl-]": "editor::Indent",
      "ctrl-d": [
        "editor::SelectNext",
        {
          "replace_newest": false
        }
      ],
      "ctrl-shift-d": [
        "editor::SelectPrevious",
        {
          "replace_newest": false
        }
      ],
      "ctrl-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "alt-up": "editor::SelectLargerSyntaxNode",
      "alt-down": "editor::SelectSmallerSyntaxNode",
      "ctrl-u": "editor::UndoSelection",
      "ctrl-shift-u": "editor::RedoSelection",
      "ctrl-m": "editor::MoveToEnclosingBracket",
      "alt-ctrl-[": "editor::Fold",
      "alt-ctrl-]": "editor::UnfoldLines",
      "ctrl-space": "editor::ShowCompletions",
      "ctrl-.": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space e e": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "q": "git_panel::Close"
    }
  },
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "ctrl-n": "search::SelectNextMatch",
      "ctrl-p": "search::SelectPreviousMatch",
      "ctrl-x": "tab_switcher::CloseSelectedItem"
    }
  },
  {
    "bindings": {
      "ctrl-p": "menu::SelectPrevious"
    }
  },
  {
    "context": "(((vim_mode == insert || vim_mode == normal) && showing_signature_help) && !showing_completions)",
    "bindings": {
      "ctrl-p": null
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "k": [
        "vim::Up",
        {
          "display_lines": true
        }
      ]
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "j": [
        "vim::Down",
        {
          "display_lines": true
        }
      ]
    }
  }
]
